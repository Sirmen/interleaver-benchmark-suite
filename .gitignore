# MATLAB
*.asv
*.m~
# Timestamped working backups (<name>.YYYYMMDD-HHMM.bak). They are made
# in the working tree beside each edit; a copy of one inside the release
# is an accident, and an accident that ships is indistinguishable from a
# second, older implementation of the same file.
*.bak
# audit_dependencies writes this; it is a report, not a source
dependency_audit.txt
*.mex*
slprj/
# campaign output: archived on Zenodo, not in git
data/results/
results/
figures/
*.fig
# large binaries
*.mat
!tables/*.mat
# OS
.DS_Store
Thumbs.db
desktop.ini

# The divisor table is 235 MB: over GitHub's per-file limit. It is NOT required
# - PrimeFactorLoader runs without it and says which methods then compute their
# own values - and it is archived with the campaign data record, where
# DATA_README lists it. Drop it in tables/ to use the cache instead.
tables/factors.mat
